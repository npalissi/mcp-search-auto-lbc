{
  "name": "mcp-search-auto-lbc",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur MCP de recherche et de cote automobile à partir d'annonces Leboncoin comparables",
  "scripts": {
    "start": "tsx mcp/server.ts",
    "dev": "tsx watch mcp/server.ts",
    "test": "tsx --test src/lib/leboncoin/advanced-valuation.test.ts src/lib/leboncoin/resolver.test.ts mcp/server.test.ts",
    "python:check": "python3.11 -m py_compile python/lbc_worker.py",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run python:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
